{
  "name": "ppt-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A usable, demonstrable PPT-generation harness built on Anthropic's pptx skill, with rich icons (react-icons) and images (open-source stock + AI-gen). 文图并茂。",
  "main": "harness.js",
  "scripts": {
    "chat": "node chat.js",
    "deck": "node chat.js --once",
    "blankcheck": "node blank-harness/blankcheck.js",
    "eval": "node blank-harness/eval-blanks.js",
    "bench-blank": "node blank-harness/bench-blank.js",
    "demo": "node examples/ai-healthcare.js",
    "demo:light": "node examples/ai-healthcare.js --no-images",
    "qa": "node -e \"require('./lib/qa').cli()\""
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "sharp": "^0.33.0"
  }
}
